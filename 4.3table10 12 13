xlabel(ax,'Corrections k'); ylabel(ax,'Runtime (s)');
title(ax,'Case B: N = 64, M = 1000, P = 32');
set(ax,'XTick',q.K); grid(ax,'on');
legend(ax,{'Original','Local calibration','Transferred calibration','Measured'}, ...
    'Location','best');
savePlot(f,outDir,'Figure_CaseB_Validation'); close(f);

f=figure('Visible','off','Color','w','Position',[100 100 720 430]);
ax=axes('Parent',f); q=U(U.CaseID==1,:);
plot(ax,q.Iteration,q.CVG_percent,'-o','LineWidth',1.4); hold(ax,'on');
