
 clear;
 clc;
close all;

%% ========================================================================
%  USER PARAMETERS
%  ========================================================================

% ------------------------------------------------------------------------
% Physical parameters for Allen-Cahn equation
% ------------------------------------------------------------------------

L = 1.0;
T = 1.0;

epsilon = 0.1;

% Diffusion coefficient in
%
%     u_t = epsilon^2*u_xx + u - u^3
%
diffusionCoeff = epsilon^2;

% ------------------------------------------------------------------------
% SELECT COARSE AND FINE METHODS HERE
% ------------------------------------------------------------------------
%
% Available choices:
%
%   'BE'
%   'IM2'
%   'RK3'
%   'RK4'
%
% Examples:
%
%   coarseMethod = 'BE';
%   fineMethod   = 'RK4';
%
% gives p = 1, q = 4.
%
%   coarseMethod = 'BE';
%   fineMethod   = 'RK4';
%
% gives p = 2, q = 4.
%

coarseMethod = 'BE';

fineMethod   = 'IM2';

% Automatically obtain formal orders

pCoarse = methodOrder(coarseMethod);

qFine = methodOrder(fineMethod);

% ------------------------------------------------------------------------
% Spatial grid
% ------------------------------------------------------------------------
%
% The original Allen-Cahn temporal experiment in the paper uses J = 40.
%

J = 40;

h = L/J;

x = linspace(0,L,J+1).';

xInterior = x(2:end-1);

ndof = J-1;

% ------------------------------------------------------------------------
% Experiment 1: Parareal iteration convergence
% ------------------------------------------------------------------------

N = 20;

% Number of fine time steps inside each coarse time interval.
%
% Original Allen-Cahn experiment:
%
%     Mfine = 200
%
% You can change this value manually for additional tests.
%

% Mfine = 5;
Mfine = 5;
% Maximum Parareal iteration

K = 2;

% ------------------------------------------------------------------------
% Experiment 2: temporal refinement
% ------------------------------------------------------------------------
%
% Original Allen-Cahn temporal refinement:
%
%     N = 20, 40, 80, 160, 320
%

% Nlist = [20 40 80 160 320 640 ];
% Nlist = [ 80 160 320 640  ];
Nlist = [ 80 160 320 640 ];
% ------------------------------------------------------------------------
% Reference solution
% ------------------------------------------------------------------------
%
% The finest output grid is chosen so that all temporal grids are nested.
%

NrefGrid = max([N Nlist]);

% ------------------------------------------------------------------------
% Reference RK4 substeps
%
% The paper uses approximately
%
%     dt_ref = 1.953125e-6.
%
% Since NrefGrid = 320,
%
%     MrefFine = 1600
%
% gives
%
%     dt_ref = 1/(320*1600)
%            = 1.953125e-6.
%
% MrefCoarse is used only for the reference self-convergence check.
% ------------------------------------------------------------------------

MrefCoarse = 20;

MrefFine = 50;

% ------------------------------------------------------------------------
% Newton solver parameters
%
% Used only for BE and IM2
% ------------------------------------------------------------------------

newtonTol = 1.0e-12;

newtonMaxit = 40;

% ------------------------------------------------------------------------
% Parallel fine propagation
% ------------------------------------------------------------------------

useParallel = false;

% ------------------------------------------------------------------------
% Save CSV files
% ------------------------------------------------------------------------

saveOutputs = true;

%% ========================================================================
%  METHOD CHECK
%  ========================================================================

fprintf('\n');
fprintf('====================================================================\n');
fprintf('SELECTED PARAREAL METHODS\n');
fprintf('====================================================================\n');

fprintf('Coarse method      : %s\n', ...
    methodFullName(coarseMethod));

fprintf('Coarse order p     : %d\n', ...
    pCoarse);

fprintf('Fine method        : %s\n', ...
    methodFullName(fineMethod));

fprintf('Fine order q       : %d\n', ...
    qFine);

if pCoarse <= qFine

    fprintf('Theory assumption  : p <= q satisfied\n');

    fprintf('Error-bound exponent: min{%d(k+1),%d}\n', ...
        pCoarse,qFine);

else

    warning([ ...
        'The theoretical analysis assumes p <= q, ', ...
        'but the selected methods give p = %d > q = %d. ', ...
        'The computation can still run, but the theoretical ', ...
        'formula should not be directly applied.' ...
        ], ...
        pCoarse,qFine);

end

fprintf('====================================================================\n');

%% ========================================================================
%  ALLEN-CAHN NONLINEARITY AND INITIAL CONDITION
%  ========================================================================
%
% Allen-Cahn reaction:
%
%     f(u) = u - u^3
%
% and
%
%     f'(u) = 1 - 3u^2.
%

reaction = @(u) ...
    u - u.^3;

reactionPrime = @(u) ...
    1.0 - 3.0*u.^2;

% Initial condition:
%
%     u(x,0) = 0.8*sin(2*pi*x)
%

u0 = ...
    0.8*sin(2.0*pi*xInterior);

%% ========================================================================
%  SPATIAL SEMI-DISCRETIZATION
%  ========================================================================
%
% u_t = epsilon^2*u_xx + u - u^3
%
% gives
%
% U'(t) = A_h U(t) + F(U(t)),
%
% where A_h approximates epsilon^2*d^2/dx^2.
%

e = ones(ndof,1);

A0 = spdiags( ...
    [e -2.0*e e], ...
    [-1 0 1], ...
    ndof,ndof);

Ah = ...
    (diffusionCoeff/h^2)*A0;

% Spectral radius of the discrete diffusion operator

rhoAh = ...
    max(abs(eig(full(Ah))));

%% ========================================================================
%  BASIC TIME INFORMATION
%  ========================================================================

DeltaT = ...
    T/N;

deltat = ...
    DeltaT/Mfine;

dtRefCoarse = ...
    T/(NrefGrid*MrefCoarse);

dtRefFine = ...
    T/(NrefGrid*MrefFine);

%% ========================================================================
%  PRINT PARAMETERS
%  ========================================================================

fprintf('\n');
fprintf('====================================================================\n');
fprintf('ALLEN-CAHN PARAREAL EXPERIMENT\n');
fprintf('====================================================================\n');

fprintf('epsilon            = %.8e\n', ...
    epsilon);

fprintf('epsilon^2          = %.8e\n', ...
    diffusionCoeff);

fprintf('T                  = %.8e\n', ...
    T);

fprintf('\n');

fprintf('J                  = %d\n', ...
    J);

fprintf('h                  = %.8e\n', ...
    h);

fprintf('Unknowns           = %d\n', ...
    ndof);

fprintf('\n');

fprintf('Coarse method      = %s\n', ...
    methodFullName(coarseMethod));

fprintf('p                  = %d\n', ...
    pCoarse);

fprintf('Fine method        = %s\n', ...
    methodFullName(fineMethod));

fprintf('q                  = %d\n', ...
    qFine);

fprintf('\n');

fprintf('N                  = %d\n', ...
    N);

fprintf('DeltaT             = %.12e\n', ...
    DeltaT);

fprintf('Mfine              = %d\n', ...
    Mfine);

fprintf('deltat             = %.12e\n', ...
    deltat);

fprintf('\n');

fprintf('rho(-Ah)           = %.12e\n', ...
    rhoAh);

fprintf('DeltaT*rho(-Ah)    = %.12e\n', ...
    DeltaT*rhoAh);

fprintf('deltat*rho(-Ah)    = %.12e\n', ...
    deltat*rhoAh);

fprintf('\n');

fprintf('NrefGrid           = %d\n', ...
    NrefGrid);

fprintf('MrefCoarse         = %d\n', ...
    MrefCoarse);

fprintf('Reference dt #1    = %.12e\n', ...
    dtRefCoarse);

fprintf('MrefFine           = %d\n', ...
    MrefFine);

fprintf('Reference dt #2    = %.12e\n', ...
    dtRefFine);

if pCoarse <= qFine

    fprintf('\n');

    fprintf('Error estimate     = O(DeltaT^min{%d(k+1),%d})\n', ...
        pCoarse,qFine);

end

fprintf('====================================================================\n');

%% ========================================================================
%  STABILITY CHECK
%  ========================================================================

% Coarse propagator

checkExplicitStability( ...
    coarseMethod, ...
    DeltaT, ...
    rhoAh, ...
    'coarse');

% Fine propagator

checkExplicitStability( ...
    fineMethod, ...
    deltat, ...
    rhoAh, ...
    'fine');

% Reference propagator is always RK4

checkExplicitStability( ...
    'RK4', ...
    dtRefFine, ...
    rhoAh, ...
    'reference');

%% ========================================================================
%  CHECK NESTED REFERENCE GRID
%  ========================================================================

if abs(NrefGrid/N-round(NrefGrid/N)) > 1.0e-12

    error( ...
        'N must divide NrefGrid exactly.');

end

for ii = 1:numel(Nlist)

    ratioCheck = ...
        NrefGrid/Nlist(ii);

    if abs(ratioCheck-round(ratioCheck)) > 1.0e-12

        error([ ...
            'Every value of Nlist must divide NrefGrid. ', ...
            'NrefGrid = %d, N = %d.' ...
            ], ...
            NrefGrid,Nlist(ii));

    end

end

%% ========================================================================
%  EXPERIMENT 0
%  HIGH-ACCURACY REFERENCE SOLUTION
%  ========================================================================

fprintf('\n');
fprintf('====================================================================\n');
fprintf('EXPERIMENT 0: REFERENCE SELF-CONVERGENCE CHECK\n');
fprintf('====================================================================\n');

Tref = ...
    linspace(0,T,NrefGrid+1);

% ------------------------------------------------------------------------
% Coarser reference
% ------------------------------------------------------------------------

timerRef1 = tic;

UrefCoarse = ...
    serialRK4ReferenceAtNodes( ...
    Tref, ...
    u0, ...
    Ah, ...
    reaction, ...
    MrefCoarse);

timeRefCoarse = ...
    toc(timerRef1);

% ------------------------------------------------------------------------
% Finer reference
% ------------------------------------------------------------------------

timerRef2 = tic;

UrefFine = ...
    serialRK4ReferenceAtNodes( ...
    Tref, ...
    u0, ...
    Ah, ...
    reaction, ...
    MrefFine);

timeRefFine = ...
    toc(timerRef2);

% ------------------------------------------------------------------------
% Reference self-convergence
% ------------------------------------------------------------------------

refDiff = ...
    rowGridNorm( ...
    UrefFine-UrefCoarse, ...
    h);

refSelfMax = ...
    max(refDiff);

refSelfEnd = ...
    refDiff(end);

fprintf('Reference output nodes        = %d\n', ...
    NrefGrid+1);

fprintf('MrefCoarse                    = %d\n', ...
    MrefCoarse);

fprintf('dtRefCoarse                   = %.12e\n', ...
    dtRefCoarse);

fprintf('MrefFine                      = %d\n', ...
    MrefFine);

fprintf('dtRefFine                     = %.12e\n', ...
    dtRefFine);

fprintf('Max reference difference      = %.12e\n', ...
    refSelfMax);

fprintf('Final reference difference    = %.12e\n', ...
    refSelfEnd);

fprintf('Reference runtime #1          = %.6f s\n', ...
    timeRefCoarse);

fprintf('Reference runtime #2          = %.6f s\n', ...
    timeRefFine);

fprintf('Actual reference              = finer RK4 reference\n');

fprintf('--------------------------------------------------------------------\n');

if refSelfMax > 1.0e-10

    warning([ ...
        'The reference self-convergence difference is larger ', ...
        'than 1e-10. Consider increasing MrefCoarse and MrefFine.' ...
        ]);

end

%% ========================================================================
%  EXPERIMENT 1
%  PARAREAL ITERATION CONVERGENCE
%  ========================================================================

fprintf('\n');
fprintf('====================================================================\n');
fprintf('EXPERIMENT 1: PARAREAL ITERATION CONVERGENCE\n');
fprintf('====================================================================\n');

% High-accuracy reference at the N coarse nodes

UrefN = ...
    subsetReference( ...
    UrefFine, ...
    NrefGrid, ...
    N);

% ------------------------------------------------------------------------
% Serial fine solution
% ------------------------------------------------------------------------

timerFineSerial = tic;

UfineSerial = ...
    serialFineTrajectory( ...
    u0, ...
    Ah, ...
    reaction, ...
    reactionPrime, ...
    T, ...
    N, ...
    Mfine, ...
    fineMethod, ...
    newtonTol, ...
    newtonMaxit);

serialFineTime = ...
    toc(timerFineSerial);

% ------------------------------------------------------------------------
% Parareal
% ------------------------------------------------------------------------

timerParareal = tic;

[Uhist,timing] = ...
    runPararealGeneral( ...
    u0, ...
    Ah, ...
    reaction, ...
    reactionPrime, ...
    T, ...
    N, ...
    Mfine, ...
    K, ...
    coarseMethod, ...
    fineMethod, ...
    useParallel, ...
    newtonTol, ...
    newtonMaxit);

pararealWallTime = ...
    toc(timerParareal);

%% ========================================================================
%  EXPERIMENT 1 ERROR ANALYSIS
%  ========================================================================

errMaxToFine = ...
    zeros(K+1,1);

errEndToFine = ...
    zeros(K+1,1);

errMaxToRef = ...
    zeros(K+1,1);

errEndToRef = ...
    zeros(K+1,1);

tMaxRef = ...
    zeros(K+1,1);

TT = ...
    linspace(0,T,N+1).';

for k = 0:K

    Uk = ...
        Uhist{k+1};

    % ---------------------------------------------------------------
    % Error relative to serial fine solution
    % ---------------------------------------------------------------

    dFine = ...
        rowGridNorm( ...
        Uk-UfineSerial, ...
        h);

    errMaxToFine(k+1) = ...
        max(dFine);

    errEndToFine(k+1) = ...
        dFine(end);

    % ---------------------------------------------------------------
    % Error relative to high-accuracy reference
    % ---------------------------------------------------------------

    dRef = ...
        rowGridNorm( ...
        Uk-UrefN, ...
        h);

    [errMaxToRef(k+1),idx] = ...
        max(dRef);

    errEndToRef(k+1) = ...
        dRef(end);

    tMaxRef(k+1) = ...
        TT(idx);

end

% ------------------------------------------------------------------------
% Fine method error relative to reference
% ------------------------------------------------------------------------

fineErr = ...
    rowGridNorm( ...
    UfineSerial-UrefN, ...
    h);

fineErrMax = ...
    max(fineErr);

fineErrEnd = ...
    fineErr(end);

% ------------------------------------------------------------------------
% Iteration reduction factors
% ------------------------------------------------------------------------

ratioMax = ...
    NaN(K+1,1);

ratioEnd = ...
    NaN(K+1,1);

for k = 1:K

    ratioMax(k+1) = ...
        errMaxToRef(k+1) / ...
        errMaxToRef(k);

    ratioEnd(k+1) = ...
        errEndToRef(k+1) / ...
        errEndToRef(k);

end

%% ========================================================================
%  PRINT EXPERIMENT 1
%  ========================================================================

fprintf('\n');
fprintf('A. Error relative to serial fine solution\n');

fprintf('----------------------------------------------------------------------------\n');
fprintf(' k          Max-in-time error            Final-time error\n');
fprintf('----------------------------------------------------------------------------\n');

for k = 0:K

    fprintf('%2d          %20.10e          %20.10e\n', ...
        k, ...
        errMaxToFine(k+1), ...
        errEndToFine(k+1));

end

fprintf('----------------------------------------------------------------------------\n');

fprintf('\n');
fprintf('B. Error relative to high-accuracy RK4 reference\n');

fprintf('--------------------------------------------------------------------------------------------\n');
fprintf(' k          Max-in-time error            Final-time error            time of max error\n');
fprintf('--------------------------------------------------------------------------------------------\n');

for k = 0:K

    fprintf('%2d          %20.10e          %20.10e          %10.8f\n', ...
        k, ...
        errMaxToRef(k+1), ...
        errEndToRef(k+1), ...
        tMaxRef(k+1));

end

fprintf('--------------------------------------------------------------------------------------------\n');

fprintf('\n');
fprintf('C. Serial fine propagator error relative to reference\n');

fprintf('--------------------------------------------------------------------------\n');

fprintf('Fine method             = %s\n', ...
    methodFullName(fineMethod));

fprintf('Max-in-time fine error  = %.12e\n', ...
    fineErrMax);

fprintf('Final-time fine error   = %.12e\n', ...
    fineErrEnd);

fprintf('--------------------------------------------------------------------------\n');

fprintf('\n');
fprintf('D. Parareal iteration reduction factors\n');

fprintf('----------------------------------------------------------\n');
fprintf(' k        Max-error ratio        Final-error ratio\n');
fprintf('----------------------------------------------------------\n');

for k = 1:K

    fprintf('%2d        %18.10e        %18.10e\n', ...
        k, ...
        ratioMax(k+1), ...
        ratioEnd(k+1));

end

fprintf('----------------------------------------------------------\n');

fprintf('\n');
fprintf('E. Timing information\n');

fprintf('--------------------------------------------------------------------------\n');

fprintf('Parareal wall time          = %.8f s\n', ...
    pararealWallTime);

fprintf('Serial fine time            = %.8f s\n', ...
    serialFineTime);

fprintf('Serial fine / Parareal      = %.8f\n', ...
    serialFineTime/pararealWallTime);

fprintf('Initial coarse prediction   = %.8f s\n', ...
    timing.initialCoarse);

fprintf('Fine propagation times:\n');

for k = 1:K

    fprintf('  iteration %d : %.8f s\n', ...
        k, ...
        timing.fine(k));

end

fprintf('Coarse correction times:\n');

for k = 1:K

    fprintf('  iteration %d : %.8f s\n', ...
        k, ...
        timing.correction(k));

end

fprintf('--------------------------------------------------------------------------\n');

%% ========================================================================
%  EXPERIMENT 2
%  TEMPORAL CONVERGENCE
%  ========================================================================

fprintf('\n');
fprintf('====================================================================\n');
fprintf('EXPERIMENT 2: TEMPORAL CONVERGENCE\n');
fprintf('====================================================================\n');

nCases = ...
    numel(Nlist);

DeltaTlist = ...
    T./Nlist;

errMaxOrder = ...
    zeros(K+1,nCases);

errEndOrder = ...
    zeros(K+1,nCases);

tMaxOrder = ...
    zeros(K+1,nCases);

fineMaxOrder = ...
    zeros(1,nCases);

fineEndOrder = ...
    zeros(1,nCases);

%% ========================================================================
%  TEMPORAL REFINEMENT LOOP
%  ========================================================================

for iCase = 1:nCases

    Ni = ...
        Nlist(iCase);

    DTi = ...
        T/Ni;

    dti = ...
        DTi/Mfine;

    fprintf('\n');
    fprintf('--------------------------------------------------------------------\n');

    fprintf('N                  = %d\n', ...
        Ni);

    fprintf('DeltaT             = %.12e\n', ...
        DTi);

    fprintf('Mfine              = %d\n', ...
        Mfine);

    fprintf('deltat             = %.12e\n', ...
        dti);

    fprintf('DeltaT*rho(-Ah)    = %.12e\n', ...
        DTi*rhoAh);

    fprintf('deltat*rho(-Ah)    = %.12e\n', ...
        dti*rhoAh);

    % ---------------------------------------------------------------
    % Stability checks
    % ---------------------------------------------------------------

    checkExplicitStability( ...
        coarseMethod, ...
        DTi, ...
        rhoAh, ...
        'coarse');

    checkExplicitStability( ...
        fineMethod, ...
        dti, ...
        rhoAh, ...
        'fine');

    % ---------------------------------------------------------------
    % Reference at current coarse nodes
    % ---------------------------------------------------------------

    Urefi = ...
        subsetReference( ...
        UrefFine, ...
        NrefGrid, ...
        Ni);

    TTi = ...
        linspace(0,T,Ni+1).';

    % ---------------------------------------------------------------
    % Serial fine trajectory
    % ---------------------------------------------------------------

    Ufinei = ...
        serialFineTrajectory( ...
        u0, ...
        Ah, ...
        reaction, ...
        reactionPrime, ...
        T, ...
        Ni, ...
        Mfine, ...
        fineMethod, ...
        newtonTol, ...
        newtonMaxit);

    fineDiffi = ...
        rowGridNorm( ...
        Ufinei-Urefi, ...
        h);

    fineMaxOrder(iCase) = ...
        max(fineDiffi);

    fineEndOrder(iCase) = ...
        fineDiffi(end);

    % ---------------------------------------------------------------
    % Parareal
    % ---------------------------------------------------------------

    [Uhisti,~] = ...
        runPararealGeneral( ...
        u0, ...
        Ah, ...
        reaction, ...
        reactionPrime, ...
        T, ...
        Ni, ...
        Mfine, ...
        K, ...
        coarseMethod, ...
        fineMethod, ...
        useParallel, ...
        newtonTol, ...
        newtonMaxit);

    % ---------------------------------------------------------------
    % Errors
    % ---------------------------------------------------------------

    for k = 0:K

        di = ...
            rowGridNorm( ...
            Uhisti{k+1}-Urefi, ...
            h);

        [errMaxOrder(k+1,iCase),idx] = ...
            max(di);

        errEndOrder(k+1,iCase) = ...
            di(end);

        tMaxOrder(k+1,iCase) = ...
            TTi(idx);

    end

    fprintf('Fine max error      = %.12e\n', ...
        fineMaxOrder(iCase));

    fprintf('Fine final error    = %.12e\n', ...
        fineEndOrder(iCase));

end

%% ========================================================================
%  COMPUTE OBSERVED ORDERS
%  ========================================================================

orderMax = ...
    NaN(K+1,nCases);

orderEnd = ...
    NaN(K+1,nCases);

fineOrderMax = ...
    NaN(1,nCases);

fineOrderEnd = ...
    NaN(1,nCases);

for iCase = 2:nCases

    stepRatio = ...
        DeltaTlist(iCase-1) / ...
        DeltaTlist(iCase);

    for k = 0:K

        orderMax(k+1,iCase) = ...
            log( ...
            errMaxOrder(k+1,iCase-1) / ...
            errMaxOrder(k+1,iCase)) / ...
            log(stepRatio);

        orderEnd(k+1,iCase) = ...
            log( ...
            errEndOrder(k+1,iCase-1) / ...
            errEndOrder(k+1,iCase)) / ...
            log(stepRatio);

    end

    fineOrderMax(iCase) = ...
        log( ...
        fineMaxOrder(iCase-1) / ...
        fineMaxOrder(iCase)) / ...
        log(stepRatio);

    fineOrderEnd(iCase) = ...
        log( ...
        fineEndOrder(iCase-1) / ...
        fineEndOrder(iCase)) / ...
        log(stepRatio);

end

%% ========================================================================
%  PRINT PARAREAL CONVERGENCE TABLES
%  ========================================================================

for k = 0:K

    if pCoarse <= qFine

        theoryOrder = ...
            min( ...
            pCoarse*(k+1), ...
            qFine);

    else

        theoryOrder = ...
            NaN;

    end

    fprintf('\n');
    fprintf('====================================================================\n');

    fprintf('Parareal iteration k = %d\n', ...
        k);

    if ~isnan(theoryOrder)

        fprintf( ...
            'Rate indicated by error bound min{%d*(k+1),%d} = %d\n', ...
            pCoarse, ...
            qFine, ...
            theoryOrder);

    else

        fprintf('Theory not reported because p > q.\n');

    end

    fprintf('====================================================================\n');

    % --------------------------------------------------------------------
    % Maximum-in-time error
    % --------------------------------------------------------------------

    fprintf('\n');
    fprintf('Maximum-in-time error\n');

    fprintf('--------------------------------------------------------------------------------\n');
    fprintf(' N        DeltaT               Error                 Order          t_max\n');
    fprintf('--------------------------------------------------------------------------------\n');

    for iCase = 1:nCases

        if iCase == 1

            fprintf('%4d   %.10e   %.12e          -        %.8f\n', ...
                Nlist(iCase), ...
                DeltaTlist(iCase), ...
                errMaxOrder(k+1,iCase), ...
                tMaxOrder(k+1,iCase));

        else

            fprintf('%4d   %.10e   %.12e     %8.6f        %.8f\n', ...
                Nlist(iCase), ...
                DeltaTlist(iCase), ...
                errMaxOrder(k+1,iCase), ...
                orderMax(k+1,iCase), ...
                tMaxOrder(k+1,iCase));

        end

    end

    % --------------------------------------------------------------------
    % Final-time error
    % --------------------------------------------------------------------

    fprintf('\n');
    fprintf('Final-time error\n');

    fprintf('--------------------------------------------------------------------\n');
    fprintf(' N        DeltaT               Error                 Order\n');
    fprintf('--------------------------------------------------------------------\n');

    for iCase = 1:nCases

        if iCase == 1

            fprintf('%4d   %.10e   %.12e          -\n', ...
                Nlist(iCase), ...
                DeltaTlist(iCase), ...
                errEndOrder(k+1,iCase));

        else

            fprintf('%4d   %.10e   %.12e     %8.6f\n', ...
                Nlist(iCase), ...
                DeltaTlist(iCase), ...
                errEndOrder(k+1,iCase), ...
                orderEnd(k+1,iCase));

        end

    end

end

%% ========================================================================
%  PRINT FINE METHOD CONVERGENCE
%  ========================================================================

fprintf('\n');
fprintf('====================================================================\n');

fprintf('SERIAL FINE PROPAGATOR ERROR\n');

fprintf('Fine method = %s\n', ...
    methodFullName(fineMethod));

fprintf('Formal order q = %d\n', ...
    qFine);

fprintf('====================================================================\n');

fprintf('\n');
fprintf('Final-time fine error\n');

fprintf('--------------------------------------------------------------------\n');
fprintf(' N        DeltaT               Error                 Order\n');
fprintf('--------------------------------------------------------------------\n');

for iCase = 1:nCases

    if iCase == 1

        fprintf('%4d   %.10e   %.12e          -\n', ...
            Nlist(iCase), ...
            DeltaTlist(iCase), ...
            fineEndOrder(iCase));

    else

        fprintf('%4d   %.10e   %.12e     %8.6f\n', ...
            Nlist(iCase), ...
            DeltaTlist(iCase), ...
            fineEndOrder(iCase), ...
            fineOrderEnd(iCase));

    end

end

%% ========================================================================
%  SUMMARY
%  ========================================================================

fprintf('\n');
fprintf('====================================================================\n');
fprintf('SUMMARY OF TEMPORAL ORDERS\n');
fprintf('====================================================================\n');

fprintf('Coarse method = %s, p = %d\n', ...
    methodFullName(coarseMethod), ...
    pCoarse);

fprintf('Fine method   = %s, q = %d\n', ...
    methodFullName(fineMethod), ...
    qFine);

fprintf('\n');

fprintf(' k   Bound rate    Last max-order      Last final-order      Last t_max\n');

fprintf('--------------------------------------------------------------------------------\n');

for k = 0:K

    if pCoarse <= qFine

        theoryOrder = ...
            min( ...
            pCoarse*(k+1), ...
            qFine);

        fprintf('%2d     %3d          %10.6f          %10.6f          %.8f\n', ...
            k, ...
            theoryOrder, ...
            orderMax(k+1,end), ...
            orderEnd(k+1,end), ...
            tMaxOrder(k+1,end));

    else

        fprintf('%2d       -          %10.6f          %10.6f          %.8f\n', ...
            k, ...
            orderMax(k+1,end), ...
            orderEnd(k+1,end), ...
            tMaxOrder(k+1,end));

    end

end

fprintf('================================================================================\n');

%% ========================================================================
