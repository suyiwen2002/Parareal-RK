%  ========================================================================

referenceFloorEstimate = ...
    max(refSelfMax,eps);

fprintf('\n');

fprintf('Reference self-check scale = %.3e\n', ...
    referenceFloorEstimate);

fprintf([ ...
    'Errors close to approximately 10--100 times this scale should ', ...
    'not be used for reliable convergence-order estimation.\n' ...
