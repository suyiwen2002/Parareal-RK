%% FisherKPP2D_Parareal_BE_FixedPoint.m
%
% ========================================================================
% 2D FISHER-KPP EQUATION
% ========================================================================
%
%   u_t = D*(u_xx + u_yy) + r*u*(1-u),
%   (x,y) in (0,L)^2, 0 < t <= T.
%
% Homogeneous Dirichlet boundary conditions:
%
%   u = 0 on boundary.
%
% Initial condition:
%
%   u0(x,y) =
%       exp(-alpha*((x-L/2)^2 + (y-L/2)^2)).
%
% ========================================================================
% PARAREAL
% ========================================================================
%
% Coarse propagator:
%
%   Fully implicit Backward Euler
%
%       U_{n+1} - U_n
%       - DeltaT*[A*U_{n+1} + r*U_{n+1}.*(1-U_{n+1})] = 0.
%
% IMPORTANT:
% The Backward Euler discretization is NOT changed.
%
% The nonlinear BE algebraic system is solved by fixed-point iteration:
%
%   (I - DeltaT*A)*y^(m+1)
%       = v + DeltaT*r*y^(m).*(1-y^(m)).
%
% At convergence this satisfies exactly the fully implicit BE equation.
%
% The matrix
%
%       B = I - DeltaT*A
%
% is constant. Therefore its sparse LU factorization is computed ONCE
% and reused for all:
%
%   - coarse intervals,
%   - Parareal iterations,
%   - fixed-point iterations.
%
% Fine propagator:
%
%   Classical fourth-order Runge-Kutta (RK4).
%
% ========================================================================
% TIMING
% ========================================================================
%
% For EACH K:
%
%   1. Serial fine RK4 is independently timed nRepeats times.
%   2. Parareal is independently timed nRepeats times.
%   3. Median times are reported.
%
% Pool startup, factorization, and warm-up are excluded.
%
% ========================================================================

clear;
clc;
close all;

%% ========================================================================
% PARAMETERS
% ========================================================================

% Spatial domain
L = 1.0;

% Final time
T = 5.0;

% Fisher-KPP parameters
D = 1.0e-2;
r = 1.0;

% Spatial mesh
J = 80;

% Number of coarse time intervals
N = 40;

% Fine RK4 steps per coarse interval
Mfine = 1024;

% Parareal iterations
Klist = [1 2 3];

% Independent timing repetitions
nRepeats = 3;

% Gaussian initial condition
alpha = 100.0;

% ------------------------------------------------------------------------
% Fixed-point solver parameters for fully implicit BE
% ------------------------------------------------------------------------

% Residual tolerance for the ORIGINAL BE equation
fpTol = 1.0e-10;

% Maximum fixed-point iterations
fpMaxit = 100;

% Use forward Euler predictor as initial guess?
%
% true:
%   y0 = v + DeltaT*(A*v + f(v))
%
% false:
%   y0 = v
%
% Predictor only provides the initial guess.
% It does NOT change the BE discretization.
usePredictor = true;

% Save CSV tables
saveResults = true;

%% ========================================================================
% SPATIAL GRID
% ========================================================================

h = L/J;

x = linspace(0,L,J+1).';
y = linspace(0,L,J+1).';

xInterior = x(2:end-1);
yInterior = y(2:end-1);

nx = J-1;
ny = J-1;

ndof = nx*ny;

[Xint,Yint] = meshgrid(xInterior,yInterior);

%% ========================================================================
% INITIAL CONDITION
% ========================================================================

u0Grid = ...
    exp( ...
        -alpha*( ...
            (Xint-L/2).^2 ...
            + (Yint-L/2).^2 ...
        ) ...
    );

u0 = u0Grid(:);

%% ========================================================================
% 2D DIFFUSION MATRIX
% ========================================================================

Ah = ...
    buildDiffusionMatrix2D( ...
        J,L,D);

Ih = speye(ndof);

%% ========================================================================
% TIME PARAMETERS
% ========================================================================

DeltaT = T/N;

deltat = DeltaT/Mfine;

%% ========================================================================
% FIXED MATRIX FOR BACKWARD EULER FIXED-POINT ITERATION
% ========================================================================
%
% Fixed-point equation:
%
%   (I - DeltaT*A)*y_(m+1)
%       = v + DeltaT*r*y_m.*(1-y_m).
%
% Therefore
%
%   B = I - DeltaT*A
%
% is constant.
% ========================================================================

BEFixedMatrix = ...
    Ih ...
    - DeltaT*Ah;

fprintf('\n');
fprintf('Factorizing fixed BE matrix once...\n');

factorTimer = tic;

BEFixedSolver = ...
    decomposition( ...
        BEFixedMatrix, ...
        'lu');

BEFactorizationTime = toc(factorTimer);

fprintf('Fixed BE matrix factorization time = %.8f s\n', ...
    BEFactorizationTime);

fprintf('Factorization is excluded from propagation timings.\n');

%% ========================================================================
% RK4 STABILITY INFORMATION
% ========================================================================

rhoMinusAh = ...
    8.0*D/h^2 ...
    * cos(pi/(2.0*J))^2;

% For Fisher-KPP, diffusion is the stiff component.
% This quantity is used as a practical diffusion stability diagnostic.

stabilityNumber = ...
    deltat*rhoMinusAh;

%% ========================================================================
% BASIC INFORMATION
% ========================================================================

fprintf('\n');
fprintf('====================================================================\n');
fprintf('2D FISHER-KPP PARAREAL PERFORMANCE TEST\n');
fprintf('FIXED-LU FULLY IMPLICIT BACKWARD EULER COARSE SOLVER\n');
fprintf('====================================================================\n');

fprintf('Equation                        : u_t = D*Delta(u) + r*u*(1-u)\n');

fprintf('Domain                          = [0,%.2f]^2\n',L);

fprintf('Final time T                    = %.8e\n',T);

fprintf('\n');

fprintf('Diffusion coefficient D         = %.8e\n',D);

fprintf('Reaction rate r                 = %.8e\n',r);

fprintf('\n');

fprintf('J in each spatial direction     = %d\n',J);

fprintf('Interior grid size              = %d x %d\n',nx,ny);

fprintf('Number of unknowns              = %d\n',ndof);

fprintf('h                               = %.8e\n',h);

fprintf('\n');

fprintf('Gaussian alpha                  = %.8e\n',alpha);

fprintf('Initial maximum                 = %.8e\n',max(u0));

fprintf('Initial minimum                 = %.8e\n',min(u0));

fprintf('\n');

fprintf('N                               = %d\n',N);

fprintf('DeltaT                          = %.8e\n',DeltaT);

fprintf('Mfine                           = %d\n',Mfine);

fprintf('Fine RK4 step deltat            = %.8e\n',deltat);

fprintf('Total serial RK4 steps          = %d\n',N*Mfine);

fprintf('\n');

fprintf('Parareal iterations tested      = ');

fprintf('%d ',Klist);

fprintf('\n\n');

fprintf('Coarse propagator               = fully implicit Backward Euler\n');

fprintf('BE nonlinear solver             = fixed-point iteration\n');

fprintf('BE linear algebra               = one fixed sparse LU factorization\n');

fprintf('Fine propagator                 = classical RK4\n');

fprintf('\n');

fprintf('Fixed-point residual tolerance  = %.3e\n',fpTol);

fprintf('Fixed-point maximum iterations  = %d\n',fpMaxit);

fprintf('Forward Euler predictor         = %d\n',usePredictor);

fprintf('\n');

fprintf('rho(-Ah)                        = %.8e\n',rhoMinusAh);

fprintf('deltat*rho(-Ah)                 = %.8e\n',stabilityNumber);

fprintf('RK4 diffusion stability guide   : deltat*rho(-Ah) < about 2.785\n');

fprintf('\n');

fprintf('BE fixed matrix factorization   = %.8f s\n', ...
    BEFactorizationTime);

fprintf('Factorization excluded from timing.\n');

fprintf('====================================================================\n');

if stabilityNumber >= 2.785

    error( ...
        ['Fine RK4 may be unstable. ', ...
         'Increase Mfine, increase N, or decrease J.']);

end

%% ========================================================================
% PARALLEL POOL
% ========================================================================

fprintf('\n');
fprintf('====================================================================\n');
fprintf('PARALLEL POOL INFORMATION\n');
fprintf('====================================================================\n');

if ~license('test','Distrib_Computing_Toolbox')

    error('Parallel Computing Toolbox is required.');

end

localCluster = parcluster('local');

maxWorkers = localCluster.NumWorkers;

fprintf('Maximum available workers       = %d\n',maxWorkers);

pool = gcp('nocreate');

if isempty(pool)

    fprintf('No parallel pool is currently open.\n');

    fprintf('Starting a pool with %d workers...\n',maxWorkers);

    pool = parpool('local',maxWorkers);

else

    fprintf('Existing parallel pool found.\n');

    fprintf('Current pool workers            = %d\n',pool.NumWorkers);

    if pool.NumWorkers == maxWorkers

        fprintf('The existing pool already uses the maximum number of workers.\n');

        fprintf('The pool will NOT be restarted.\n');

    else

        fprintf( ...
            ['WARNING: existing pool has %d workers, ', ...
             'maximum available is %d.\n'], ...
            pool.NumWorkers, ...
            maxWorkers);

        fprintf('The existing pool will NOT be restarted automatically.\n');

    end

end

nWorkers = pool.NumWorkers;

fprintf('\n');

fprintf('Workers used by Parareal        = %d\n',nWorkers);

fprintf('====================================================================\n');

%% ========================================================================
% SERIAL THREAD SETTING
% ========================================================================

fprintf('\n');
fprintf('====================================================================\n');
fprintf('SERIAL BASELINE THREAD SETTING\n');
fprintf('====================================================================\n');

originalClientThreads = maxNumCompThreads;

fprintf('Original client thread limit    = %d\n',originalClientThreads);

maxNumCompThreads(1);

fprintf('Client threads during test      = %d\n',maxNumCompThreads);

fprintf('====================================================================\n');

try

%% ========================================================================
% TEST THE BE SOLVER BEFORE TIMING
% ========================================================================

fprintf('\n');
fprintf('====================================================================\n');
fprintf('BACKWARD EULER FIXED-POINT SOLVER TEST\n');
fprintf('====================================================================\n');

[yTest,testInfo] = ...
    coarseBackwardEulerFisherFixedPoint( ...
        u0, ...
        Ah, ...
        r, ...
        DeltaT, ...
        BEFixedSolver, ...
        fpTol, ...
        fpMaxit, ...
        usePredictor);

fprintf('Test converged                  = %d\n',testInfo.converged);

fprintf('Test fixed-point iterations     = %d\n',testInfo.iterations);

fprintf('Test final BE residual inf-norm = %.12e\n', ...
    testInfo.residual);

fprintf('Test solution minimum           = %.12e\n',min(yTest));

fprintf('Test solution maximum           = %.12e\n',max(yTest));

fprintf('====================================================================\n');

if ~testInfo.converged

    error( ...
        ['The fixed-point BE solver failed the initial convergence test. ', ...
         'Do not use performance timings from this run.']);

end

clear yTest testInfo;

%% ========================================================================
% SERIAL WARM-UP
% ========================================================================

fprintf('\n');
fprintf('====================================================================\n');
fprintf('SERIAL WARM-UP\n');
fprintf('====================================================================\n');

dummyFine = ...
    finePropRK4Fisher( ...
        u0, ...
        Ah, ...
        r, ...
        DeltaT, ...
        Mfine);

[dummyCoarse,dummyInfo] = ...
    coarseBackwardEulerFisherFixedPoint( ...
        u0, ...
        Ah, ...
        r, ...
        DeltaT, ...
        BEFixedSolver, ...
        fpTol, ...
        fpMaxit, ...
        usePredictor);

if ~dummyInfo.converged

    error('BE fixed-point warm-up did not converge.');

end

clear dummyFine dummyCoarse dummyInfo;

fprintf('Serial warm-up completed.\n');

%% ========================================================================
% PARALLEL WORKER WARM-UP
% ========================================================================

fprintf('\n');
fprintf('====================================================================\n');
fprintf('PARALLEL WORKER WARM-UP\n');
fprintf('====================================================================\n');

warmResult = zeros(nWorkers,1);

parfor iw = 1:nWorkers

    yWarm = ...
        finePropRK4Fisher( ...
            u0, ...
            Ah, ...
            r, ...
            DeltaT, ...
            Mfine);

    warmResult(iw) = yWarm(1);

end

if any(~isfinite(warmResult))

    error('Parallel RK4 warm-up produced NaN or Inf.');

end

clear warmResult;

fprintf('Parallel worker warm-up completed.\n');

fprintf('Warm-up time is NOT included in reported timings.\n');

%% ========================================================================
% PARAREAL CODE-PATH WARM-UP
% ========================================================================

fprintf('\n');
fprintf('====================================================================\n');
fprintf('PARAREAL CODE-PATH WARM-UP\n');
fprintf('====================================================================\n');

NparWarm = min(N,nWorkers);

TparWarm = NparWarm*DeltaT;

[~,warmTiming] = ...
    runPararealBE_RK4_ParallelFisherFixedPoint( ...
        u0, ...
        Ah, ...
        r, ...
        BEFixedSolver, ...
        TparWarm, ...
        NparWarm, ...
        Mfine, ...
        1, ...
        fpTol, ...
        fpMaxit, ...
        usePredictor);

if warmTiming.failedCoarseSolves > 0

    error('A BE coarse solve failed during Parareal warm-up.');

end

clear warmTiming;

fprintf('Parareal code-path warm-up completed.\n');

fprintf('Warm-up time is NOT included in reported timings.\n');

%% ========================================================================
% STORAGE
% ========================================================================

nK = numel(Klist);

TableK = zeros(nK,1);

TableSerialTime = zeros(nK,1);

TablePararealTime = zeros(nK,1);

TableSpeedup = zeros(nK,1);

TableEfficiency = zeros(nK,1);

TableError = zeros(nK,1);

TableRelativeError = zeros(nK,1);

TableMaxError = zeros(nK,1);

TableTimeReduction = zeros(nK,1);

TableInitialCoarse = zeros(nK,1);

TableParallelFine = zeros(nK,1);

TableCorrection = zeros(nK,1);

TableMeanFPIterations = zeros(nK,1);

TableMaxFPIterations = zeros(nK,1);

TableMaxBEResidual = zeros(nK,1);

TableFailedCoarse = zeros(nK,1);

Kplot = max(Klist);

uFineSerialForPlot = [];

uParFinalForPlot = [];

%% ========================================================================
% INDEPENDENT PERFORMANCE TEST FOR EACH K
% ========================================================================

for iK = 1:nK

    Kpar = Klist(iK);

    fprintf('\n');
    fprintf('####################################################################\n');
    fprintf('INDEPENDENT PERFORMANCE TEST FOR K = %d\n',Kpar);
    fprintf('####################################################################\n');

    %% ====================================================================
    % SERIAL FINE RK4
    % ====================================================================

    fprintf('\n');
    fprintf('====================================================================\n');
    fprintf('SERIAL FINE RK4 TIMING FOR K = %d\n',Kpar);
    fprintf('====================================================================\n');

    fprintf('Client computational threads    = 1\n');

    fprintf('Fine time step deltat           = %.12e\n',deltat);

    fprintf('Total RK4 steps                 = %d\n',N*Mfine);

    fprintf('--------------------------------------------------------------------\n');

    serialTimes = zeros(nRepeats,1);

    uFineSerial = [];

    for iRun = 1:nRepeats

        timerSerial = tic;

        uFineSerial = ...
            serialFineRK4FinalFisher( ...
                u0, ...
                Ah, ...
                r, ...
                T, ...
                N, ...
                Mfine);

        serialTimes(iRun) = toc(timerSerial);

        fprintf( ...
            'Serial RK4 K=%d, run %d / %d : %.8f s\n', ...
            Kpar, ...
            iRun, ...
            nRepeats, ...
            serialTimes(iRun));

    end

    serialTimeMedian = median(serialTimes);

    serialTimeMean = mean(serialTimes);

    serialTimeMin = min(serialTimes);

    fprintf('--------------------------------------------------------------------\n');

    fprintf('Serial RK4 median time          = %.8f s\n', ...
        serialTimeMedian);

    fprintf('Serial RK4 mean time            = %.8f s\n', ...
        serialTimeMean);

    fprintf('Serial RK4 minimum time         = %.8f s\n', ...
        serialTimeMin);

    fprintf('--------------------------------------------------------------------\n');

    if any(~isfinite(uFineSerial))

        error('Serial fine RK4 solution contains NaN or Inf.');

    end

    %% ====================================================================
    % PARAREAL
    % ====================================================================

    fprintf('\n');
    fprintf('====================================================================\n');
    fprintf('PARAREAL PARALLEL TIMING: K = %d\n',Kpar);
    fprintf('====================================================================\n');

    fprintf('Number of workers               = %d\n',nWorkers);

    fprintf('Number of corrections K         = %d\n',Kpar);

    fprintf('Number of coarse intervals N    = %d\n',N);

    fprintf('Fine steps per interval         = %d\n',Mfine);

    fprintf('--------------------------------------------------------------------\n');

    pararealTimes = zeros(nRepeats,1);

    initialCoarseTimes = zeros(nRepeats,1);

    totalFineTimes = zeros(nRepeats,1);

    totalCorrectionTimes = zeros(nRepeats,1);

    fineTimesEachRun = zeros(nRepeats,Kpar);

    correctionTimesEachRun = zeros(nRepeats,Kpar);

    meanFPIterationsRuns = zeros(nRepeats,1);

    maxFPIterationsRuns = zeros(nRepeats,1);

    maxBEResidualRuns = zeros(nRepeats,1);

    failedCoarseRuns = zeros(nRepeats,1);

    Upar = [];

    timing = [];

    for iRun = 1:nRepeats

        timerParareal = tic;

        [Upar,timing] = ...
            runPararealBE_RK4_ParallelFisherFixedPoint( ...
                u0, ...
                Ah, ...
                r, ...
                BEFixedSolver, ...
                T, ...
                N, ...
                Mfine, ...
                Kpar, ...
                fpTol, ...
                fpMaxit, ...
                usePredictor);

        pararealTimes(iRun) = toc(timerParareal);

        initialCoarseTimes(iRun) = ...
            timing.initialCoarse;

        totalFineTimes(iRun) = ...
            sum(timing.fine);

        totalCorrectionTimes(iRun) = ...
            sum(timing.correction);

        fineTimesEachRun(iRun,:) = ...
            timing.fine(:).';

        correctionTimesEachRun(iRun,:) = ...
            timing.correction(:).';

        meanFPIterationsRuns(iRun) = ...
            timing.meanFPIterations;

        maxFPIterationsRuns(iRun) = ...
            timing.maxFPIterations;

        maxBEResidualRuns(iRun) = ...
            timing.maxBEResidual;

        failedCoarseRuns(iRun) = ...
            timing.failedCoarseSolves;

        fprintf( ...
            'Parareal K=%d, run %d / %d : %.8f s\n', ...
            Kpar, ...
            iRun, ...
            nRepeats, ...
            pararealTimes(iRun));

        fprintf( ...
            '    mean FP iterations = %.4f, max = %d, max BE residual = %.3e\n', ...
            timing.meanFPIterations, ...
            timing.maxFPIterations, ...
            timing.maxBEResidual);

    end

    %% ====================================================================
    % CHECK NONLINEAR SOLVER
    % ====================================================================

    if any(failedCoarseRuns > 0)

        error( ...
            ['At least one fully implicit BE coarse solve failed ', ...
             'to satisfy the residual tolerance. ', ...
             'Do not use these timings.']);

    end

    %% ====================================================================
    % TIMING STATISTICS
    % ====================================================================

    pararealTimeMedian = median(pararealTimes);

    pararealTimeMean = mean(pararealTimes);

    pararealTimeMin = min(pararealTimes);

    initialCoarseTime = median(initialCoarseTimes);

    parallelFineTime = median(totalFineTimes);

    serialCorrectionTime = median(totalCorrectionTimes);

    fineIterationTime = ...
        median(fineTimesEachRun,1);

    correctionIterationTime = ...
        median(correctionTimesEachRun,1);

    meanFPIterations = ...
        median(meanFPIterationsRuns);

    maxFPIterations = ...
        max(maxFPIterationsRuns);

    maxBEResidual = ...
        max(maxBEResidualRuns);

    failedCoarse = ...
        max(failedCoarseRuns);

    %% ====================================================================
    % ACCURACY
    % ====================================================================

    uParFinal = Upar(end,:).';

    if any(~isfinite(uParFinal))

        error('Final Parareal solution contains NaN or Inf.');

    end

    finalError = ...
        gridNorm2D( ...
            uParFinal-uFineSerial, ...
            h);

    serialSolutionNorm = ...
        gridNorm2D( ...
            uFineSerial, ...
            h);

    relativeFinalError = ...
        finalError ...
        / max(serialSolutionNorm,eps);

    maxPointwiseError = ...
        max(abs(uParFinal-uFineSerial));

    %% ====================================================================
    % SPEEDUP
    % ====================================================================

    speedup = ...
        serialTimeMedian ...
        / pararealTimeMedian;

    parallelEfficiency = ...
        speedup ...
        / nWorkers;

    timeReduction = ...
        100.0 ...
        * (serialTimeMedian-pararealTimeMedian) ...
        / serialTimeMedian;

    %% ====================================================================
    % RESULTS
    % ====================================================================

    fprintf('\n');
    fprintf('--------------------------------------------------------------------\n');
    fprintf('RESULT FOR K = %d\n',Kpar);
    fprintf('--------------------------------------------------------------------\n');

    fprintf('Serial fine RK4 median time     = %.8f s\n', ...
        serialTimeMedian);

    fprintf('Parareal median wall time       = %.8f s\n', ...
        pararealTimeMedian);

    fprintf('\n');

    fprintf('Speedup S = Tserial/Tpara       = %.8f\n', ...
        speedup);

    fprintf('Parallel efficiency E = S/P     = %.8f\n', ...
        parallelEfficiency);

    fprintf('Parallel efficiency             = %.2f %%\n', ...
        100.0*parallelEfficiency);

    fprintf('Computational time reduction    = %.2f %%\n', ...
        timeReduction);

    fprintf('\n');

    fprintf('Final L2 error to serial RK4    = %.12e\n', ...
        finalError);

    fprintf('Relative final error            = %.12e\n', ...
        relativeFinalError);

    fprintf('Maximum pointwise error         = %.12e\n', ...
        maxPointwiseError);

    fprintf('\n');

    fprintf('Initial coarse prediction       = %.8f s\n', ...
        initialCoarseTime);

    fprintf('All parallel fine phases        = %.8f s\n', ...
        parallelFineTime);

    fprintf('All serial correction phases    = %.8f s\n', ...
        serialCorrectionTime);

    fprintf('\n');

    fprintf('Mean fixed-point iterations     = %.4f\n', ...
        meanFPIterations);

    fprintf('Maximum fixed-point iterations  = %d\n', ...
        maxFPIterations);

    fprintf('Maximum original BE residual    = %.12e\n', ...
        maxBEResidual);

    fprintf('Failed BE coarse solves         = %d\n', ...
        failedCoarse);

    fprintf('\n');

    finePhaseEffectiveSpeedup = ...
        serialTimeMedian ...
        / max(parallelFineTime/Kpar,eps);

    fprintf('Effective fine-phase speedup    = %.8f\n', ...
        finePhaseEffectiveSpeedup);

    fprintf('\n');

    for kk = 1:Kpar

        fprintf( ...
            'Iteration %d: fine = %.8f s, correction = %.8f s\n', ...
            kk, ...
            fineIterationTime(kk), ...
            correctionIterationTime(kk));

    end

    fprintf('\n');

    fprintf('Serial RK4 mean                 = %.8f s\n', ...
        serialTimeMean);

    fprintf('Serial RK4 minimum              = %.8f s\n', ...
        serialTimeMin);

    fprintf('Parareal mean                   = %.8f s\n', ...
        pararealTimeMean);

    fprintf('Parareal minimum                = %.8f s\n', ...
        pararealTimeMin);

    fprintf('--------------------------------------------------------------------\n');

    %% ====================================================================
    % STORE
    % ====================================================================

    TableK(iK) = Kpar;

    TableSerialTime(iK) = serialTimeMedian;

    TablePararealTime(iK) = pararealTimeMedian;

    TableSpeedup(iK) = speedup;

    TableEfficiency(iK) = ...
        100.0*parallelEfficiency;

    TableError(iK) = finalError;

    TableRelativeError(iK) = relativeFinalError;

    TableMaxError(iK) = maxPointwiseError;

    TableTimeReduction(iK) = timeReduction;

    TableInitialCoarse(iK) = initialCoarseTime;

    TableParallelFine(iK) = parallelFineTime;

    TableCorrection(iK) = serialCorrectionTime;

    TableMeanFPIterations(iK) = meanFPIterations;

    TableMaxFPIterations(iK) = maxFPIterations;

    TableMaxBEResidual(iK) = maxBEResidual;

    TableFailedCoarse(iK) = failedCoarse;

    if Kpar == Kplot

        uFineSerialForPlot = uFineSerial;

        uParFinalForPlot = uParFinal;

    end

end

%% ========================================================================
% FINAL TABLE
% ========================================================================

fprintf('\n');
fprintf('====================================================================\n');
fprintf('FINAL 2D FISHER-KPP PERFORMANCE TABLE\n');
fprintf('====================================================================\n');

K = TableK;

Tserial = TableSerialTime;

Tpar = TablePararealTime;

SP = TableSpeedup;

EP_percent = TableEfficiency;

Error = TableError;

RelativeError = TableRelativeError;

MaxError = TableMaxError;

TimeReduction_percent = TableTimeReduction;

InitialCoarse = TableInitialCoarse;

ParallelFine = TableParallelFine;

Correction = TableCorrection;

MeanFPIter = TableMeanFPIterations;

MaxFPIter = TableMaxFPIterations;

MaxBEResidual = TableMaxBEResidual;

FailedCoarse = TableFailedCoarse;

PerformanceTable = ...
    table( ...
        K, ...
        Tserial, ...
        Tpar, ...
        SP, ...
        EP_percent, ...
        Error, ...
        RelativeError, ...
        MaxError, ...
        TimeReduction_percent, ...
        InitialCoarse, ...
        ParallelFine, ...
        Correction, ...
        MeanFPIter, ...
        MaxFPIter, ...
        MaxBEResidual, ...
        FailedCoarse);

disp(PerformanceTable);

fprintf('Number of workers P = %d\n',nWorkers);

fprintf('====================================================================\n');

%% ========================================================================
% COMPACT TABLE
% ========================================================================

fprintf('\n');
fprintf('====================================================================\n');
fprintf('COMPACT TABLE FOR THE MANUSCRIPT\n');
fprintf('====================================================================\n');

CompactTable = ...
