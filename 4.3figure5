%% ========================================================================
% LOCAL FUNCTIONS
% ========================================================================

function A = buildDiffusionMatrix2D(J,L,D)

    h = L/J;

    n = J-1;

    e = ones(n,1);

    T1 = ...
        spdiags( ...
            [e -2.0*e e], ...
            [-1 0 1], ...
            n,n);

    I1 = speye(n);

    Lap2D = ...
        kron(I1,T1) ...
        + kron(T1,I1);

    A = ...
        (D/h^2) ...
        * Lap2D;

end

% -------------------------------------------------------------------------

function y = serialFineRK4FinalFisher( ...
    u0,A,r,T,N,Mfine)

    DeltaT = T/N;

    y = u0(:);

    for n = 1:N

        y = ...
            finePropRK4Fisher( ...
                y, ...
                A, ...
                r, ...
                DeltaT, ...
                Mfine);

    end

end

% -------------------------------------------------------------------------

function [Upar,timing] = ...
    runPararealBE_RK4_ParallelFisherFixedPoint( ...
        u0,A,r,BEFixedSolver,T,N,Mfine,K, ...
        fpTol,fpMaxit,usePredictor)

    ndof = numel(u0);

    DeltaT = T/N;

    timing.initialCoarse = 0.0;

    timing.fine = zeros(K,1);

    timing.correction = zeros(K,1);

    % Diagnostics for all coarse BE solves
    allIterations = [];

    maxResidual = 0.0;

    failedSolves = 0;

    %% --------------------------------------------------------------------
    % Initial coarse prediction
    % ---------------------------------------------------------------------

    timerInitial = tic;

    Uold = zeros(N+1,ndof);

    Uold(1,:) = u0(:).';

    GoldStored = zeros(N,ndof);

    for n = 1:N

        v = Uold(n,:).';

        [Gv,info] = ...
            coarseBackwardEulerFisherFixedPoint( ...
                v, ...
                A, ...
                r, ...
                DeltaT, ...
                BEFixedSolver, ...
                fpTol, ...
                fpMaxit, ...
                usePredictor);

        allIterations(end+1,1) = info.iterations;

        maxResidual = ...
            max(maxResidual,info.residual);

        if ~info.converged
            failedSolves = failedSolves + 1;
        end

        Uold(n+1,:) = Gv.';

        GoldStored(n,:) = Gv.';

    end

    timing.initialCoarse = toc(timerInitial);

    %% --------------------------------------------------------------------
    % Parareal iterations
    % ---------------------------------------------------------------------

    for k = 1:K

        %% ----------------------------------------------------------------
        % Parallel fine phase
        % -----------------------------------------------------------------

        fineOld = zeros(N,ndof);

        timerFine = tic;

        parfor n = 1:N

            vOld = Uold(n,:).';

            Fv = ...
                finePropRK4Fisher( ...
                    vOld, ...
                    A, ...
                    r, ...
                    DeltaT, ...
                    Mfine);

            fineOld(n,:) = Fv.';

        end

        timing.fine(k) = toc(timerFine);

        if any(~isfinite(fineOld(:)))

            error( ...
                'Parallel fine RK4 produced NaN or Inf.');

        end

        %% ----------------------------------------------------------------
        % Sequential coarse correction
        % -----------------------------------------------------------------

        timerCorrection = tic;

        Unew = zeros(N+1,ndof);

        Unew(1,:) = u0(:).';

        GnewStored = zeros(N,ndof);

        for n = 1:N

            vNew = Unew(n,:).';

            [Gnew,info] = ...
                coarseBackwardEulerFisherFixedPoint( ...
                    vNew, ...
                    A, ...
                    r, ...
                    DeltaT, ...
                    BEFixedSolver, ...
                    fpTol, ...
                    fpMaxit, ...
                    usePredictor);

            allIterations(end+1,1) = info.iterations;

            maxResidual = ...
                max(maxResidual,info.residual);

            if ~info.converged
                failedSolves = failedSolves + 1;
            end

            Unew(n+1,:) = ...
                ( ...
                    Gnew ...
                    + fineOld(n,:).' ...
                    - GoldStored(n,:).' ...
                ).';

            if any(~isfinite(Unew(n+1,:)))

                error( ...
                    ['Parareal correction produced NaN or Inf ', ...
                     'at interval %d, iteration %d.'], ...
                    n,k);

            end

            GnewStored(n,:) = Gnew.';

        end

        timing.correction(k) = toc(timerCorrection);

        Uold = Unew;

        GoldStored = GnewStored;

    end

    Upar = Uold;

    %% --------------------------------------------------------------------
    % Diagnostics
    % ---------------------------------------------------------------------

    if isempty(allIterations)

        timing.meanFPIterations = 0;

        timing.maxFPIterations = 0;

    else

        timing.meanFPIterations = ...
            mean(allIterations);

        timing.maxFPIterations = ...
            max(allIterations);

    end

    timing.maxBEResidual = maxResidual;

    timing.failedCoarseSolves = failedSolves;

end

% -------------------------------------------------------------------------

function [y,info] = ...
    coarseBackwardEulerFisherFixedPoint( ...
        v,A,r,DeltaT,BEFixedSolver, ...
        tol,maxit,usePredictor)

    % =====================================================================
    % Fully implicit Backward Euler equation:
    %
    %   y - v - DeltaT*(A*y + r*y.*(1-y)) = 0.
    %
    % Fixed-point iteration:
    %
    %   (I - DeltaT*A)*y_(m+1)
    %       = v + DeltaT*r*y_m.*(1-y_m).
    %
    % At convergence:
    %
    %   (I - DeltaT*A)*y
    %       = v + DeltaT*r*y.*(1-y),
    %
    % which is EXACTLY the fully implicit BE algebraic equation.
    % =====================================================================

    v = v(:);

    if any(~isfinite(v))

        error('Backward Euler received NaN or Inf.');

    end

    %% --------------------------------------------------------------------
    % Initial guess
    % ---------------------------------------------------------------------

    if usePredictor

        % Forward Euler predictor used ONLY as an initial guess.
        %
        % This does NOT change the final BE method.

        y = ...
            v ...
            + DeltaT ...
            * ( ...
                A*v ...
                + r*v.*(1-v) ...
            );

    else

        y = v;

    end

    if any(~isfinite(y))

        y = v;

    end

    %% --------------------------------------------------------------------
    % Check initial residual
    % ---------------------------------------------------------------------

    R = ...
        y ...
        - v ...
        - DeltaT ...
        * ( ...
            A*y ...
            + r*y.*(1-y) ...
        );

    residual = norm(R,inf);

    if residual <= tol

        info.converged = true;

        info.iterations = 0;

        info.residual = residual;

        return;

    end

    %% --------------------------------------------------------------------
    % Fixed-point iteration
    % ---------------------------------------------------------------------

    converged = false;

    for iter = 1:maxit

        rhs = ...
            v ...
            + DeltaT ...
            * r ...
            * y.*(1-y);

        ynew = ...
            BEFixedSolver\rhs;

        if any(~isfinite(ynew))

            error( ...
                ['Backward Euler fixed-point iteration ', ...
                 'produced NaN or Inf.']);

        end

        % -------------------------------------------------------------
        % IMPORTANT:
        %
        % Test the ORIGINAL fully implicit BE residual,
        % not merely ||ynew-y||.
        % -------------------------------------------------------------

        Rnew = ...
            ynew ...
            - v ...
            - DeltaT ...
            * ( ...
                A*ynew ...
                + r*ynew.*(1-ynew) ...
            );

        residual = ...
            norm(Rnew,inf);

        y = ynew;

        if residual <= tol

            converged = true;

            break;

        end

    end

    info.converged = converged;

    info.iterations = iter;

    info.residual = residual;

end

% -------------------------------------------------------------------------

function y = finePropRK4Fisher( ...
    v,A,r,DeltaT,M)

    dt = DeltaT/M;

    y = v(:);

    for m = 1:M

        y = ...
            rk4StepFisher( ...
                y, ...
                A, ...
                r, ...
                dt);

        if any(~isfinite(y))

            error( ...
                ['Fine RK4 produced NaN or Inf ', ...
                 'at fine step %d of %d.'], ...
                m,M);

        end

    end

end

% -------------------------------------------------------------------------

function ynew = rk4StepFisher( ...
    y,A,r,dt)

    % Fisher-KPP semi-discrete RHS:
    %
    %   F(y) = A*y + r*y.*(1-y)

    k1 = ...
        A*y ...
        + r*y.*(1-y);

    y2 = ...
        y ...
        + 0.5*dt*k1;

    k2 = ...
        A*y2 ...
        + r*y2.*(1-y2);

    y3 = ...
        y ...
        + 0.5*dt*k2;

    k3 = ...
        A*y3 ...
        + r*y3.*(1-y3);

    y4 = ...
        y ...
        + dt*k3;

    k4 = ...
        A*y4 ...
        + r*y4.*(1-y4);

    ynew = ...
        y ...
        + (dt/6.0) ...
        * ( ...
            k1 ...
            + 2.0*k2 ...
            + 2.0*k3 ...
            + k4 ...
        );

end

% -------------------------------------------------------------------------

function nr = gridNorm2D(u,h)

    % Discrete two-dimensional L2 norm:
    %
    %   ||u||_h = sqrt(h^2 * sum_ij |u_ij|^2)

    nr = ...
        sqrt( ...
            h^2 ...
            * sum(abs(u).^2) ...
        );

end
